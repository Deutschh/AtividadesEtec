{
  "expo": {
    "name": "Memória Social",
    "slug": "memoria-social",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/memoria-social-icon.png",
    "scheme": "memoriasocial",
    "userInterfaceStyle": "light",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F1E8",
        "foregroundImage": "./assets/images/memoria-social-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/memoria-social-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#802B2F",
          "image": "./assets/images/memoria-social-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
